# Скопируйте в .env и замените все значения. Файл .env в git не попадает.
# Длинные случайные строки можно получить командой:  openssl rand -hex 32
#   или в PowerShell:  -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })

VECHER_ENV=dev
POSTGRES_PASSWORD=замените-меня
JWT_SECRET=замените-меня-длинной-строкой
CENTRIFUGO_TOKEN_SECRET=замените-меня
CENTRIFUGO_API_KEY=замените-меня
# Включите после замены обоих секретов Centrifugo на разные случайные строки от 32 символов.
VECHER_REALTIME_ENABLED=false
VECHER_REALTIME_WS_URL=ws://localhost:8100/connection/websocket
DIRECTUS_KEY=замените-меня
DIRECTUS_SECRET=замените-меня
DIRECTUS_ADMIN_EMAIL=privacy@xn--b1aga8b7a.online
DIRECTUS_ADMIN_PASSWORD=замените-меня

# Порты на 127.0.0.1 (можно не трогать)
API_PORT=8090
DB_PORT=5433
CENTRIFUGO_PORT=8100
DIRECTUS_PORT=8055
