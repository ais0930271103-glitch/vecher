# Скопировать в .env и заполнить фактические DNS/IP/пути. Секрет здесь не задаётся.
# Тег подтверждён в официальном coturn Docker README 18.10.2026; digest не выдумываем.
COTURN_IMAGE=coturn/coturn:4.18.0-r0
TURN_STATE_DIR=/opt/vecher-turn
TURN_DOMAIN=
# Реальный публичный IPv4 и IPv4 сетевого интерфейса этого TURN-хоста.
# Если публичный IP назначен прямо интерфейсу, оба значения одинаковы.
TURN_PUBLIC_IP=
TURN_LOCAL_IP=
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# PEM fullchain и соответствующий НЕ зашифрованный приватный ключ, полученные у доверенного CA.
# prepare.py проверяет срок, имя, цепочку доверия и совпадение ключа. Сам сертификат не выпускает.
TURN_CERT_FILE=
TURN_KEY_FILE=
