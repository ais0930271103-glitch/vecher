# Скопировать в .env (install.sh делает это сам и заполняет секреты). Файл .env — только на сервере.
API_PORT=8092
POSTGRES_PASSWORD=
VECHER_JWT_SECRET=
# Ключ шифрования личных данных — СВОЙ для сервера (не тот, что на ПК). Копию — в менеджер паролей.
VECHER_DATA_KEYS=
VECHER_PUBLIC_URL=https://вечер.online
# Почта для кодов входа (рег.ру). Для staging нужны рабочие SMTP-настройки; коды в лог не выводятся.
VECHER_SMTP_HOST=mail.hosting.reg.ru
VECHER_SMTP_PORT=465
VECHER_SMTP_USER=
VECHER_SMTP_PASSWORD=
VECHER_SMTP_FROM=
# Автосборка GitHub выкладывает новые версии приложения с этим токеном (тот же — в секрете RELEASE_TOKEN на GitHub).
# Создать: openssl rand -hex 32
VECHER_RELEASE_TOKEN=

# Приватные файлы в чате (каталог задаёт docker-compose.yml).
VECHER_ATTACHMENT_MAX_BYTES=26214400
VECHER_ATTACHMENT_PAIR_QUOTA_BYTES=262144000
VECHER_ATTACHMENT_PENDING_TTL_HOURS=24
# Планировщик чистит pending/orphan вложения и истёкшие звонки (по умолчанию включён).
VECHER_SCHEDULER_ENABLED=true

# Публичные блоги — выключены до отдельной миграции/проверки хранилища и бэкапа.
# Worker запускается отдельным profile public-video; см. backend/PUBLIC_VIDEO_MEDIA.md.
# Этот файл с секретами НЕ передаётся контейнеру worker.
VECHER_BLOGS_ENABLED=false
VECHER_BLOG_MEDIA_MAX_BYTES=104857600
VECHER_BLOG_MEDIA_MAX_SECONDS=180
VECHER_BLOG_MEDIA_OUTPUT_MAX_BYTES=67108864
VECHER_BLOG_MEDIA_THUMBNAIL_MAX_BYTES=1048576
VECHER_BLOG_MEDIA_BLOG_QUOTA_BYTES=536870912
VECHER_BLOG_MEDIA_GLOBAL_QUOTA_BYTES=2147483648
VECHER_BLOG_MEDIA_MAX_ASSETS_PER_BLOG=100
VECHER_BLOG_MEDIA_MAX_ASSETS_GLOBAL=500
VECHER_BLOG_MEDIA_MAX_PENDING_PER_BLOG=2
VECHER_BLOG_MEDIA_MAX_PENDING_GLOBAL=16
VECHER_BLOG_MEDIA_MIN_FREE_BYTES=268435456
VECHER_BLOG_MEDIA_UPLOAD_TIMEOUT_SECONDS=600
VECHER_BLOG_MEDIA_PROCESS_TIMEOUT_SECONDS=300
VECHER_BLOG_MEDIA_PROBE_TIMEOUT_SECONDS=20
VECHER_BLOG_MEDIA_LEASE_SECONDS=900
VECHER_BLOG_MEDIA_MAX_ATTEMPTS=3
VECHER_BLOG_MEDIA_PENDING_TTL_HOURS=24

# Звонки: в staging выключены, пока не настроен собственный TURN.
# JSON-массивы, не строки через запятую. Готовые значения создаёт infra/turn/prepare.py.
VECHER_STUN_URLS=[]
VECHER_TURN_URLS=[]
VECHER_TURN_SECRET=
VECHER_TURN_CREDENTIAL_TTL_SECONDS=15000
VECHER_CALL_RING_TIMEOUT_SECONDS=60
VECHER_CALL_HEARTBEAT_TIMEOUT_SECONDS=90
VECHER_CALL_MAX_DURATION_SECONDS=14400

# Мгновенная синхронизация. prepare-realtime.py создаёт отдельные секреты.
# Включать после миграции БД, запуска Centrifugo и маршрута Caddy.
VECHER_REALTIME_ENABLED=false
VECHER_REALTIME_WS_URL=wss://api-test.xn--b1aga8b7a.online/connection/websocket
VECHER_CENTRIFUGO_API_URL=http://centrifugo:8001/api
VECHER_CENTRIFUGO_API_KEY=
VECHER_REALTIME_TOKEN_SECRET=
VECHER_REALTIME_TOKEN_TTL_SECONDS=300
