# Скопировать в .env (install.sh делает это сам и заполняет секреты). Файл .env — только на сервере.
API_PORT=8092
POSTGRES_PASSWORD=
VECHER_JWT_SECRET=
# Ключ шифрования личных данных — СВОЙ для сервера (не тот, что на ПК). Копию — в менеджер паролей.
VECHER_DATA_KEYS=
VECHER_PUBLIC_URL=https://вечер.online
# Почта для кодов входа (рег.ру). Пока пусто — код виден в логе: docker compose logs api | grep "код для"
VECHER_SMTP_HOST=mail.hosting.reg.ru
VECHER_SMTP_PORT=465
VECHER_SMTP_USER=
VECHER_SMTP_PASSWORD=
VECHER_SMTP_FROM=
# Автосборка GitHub выкладывает новые версии приложения с этим токеном (тот же — в секрете RELEASE_TOKEN на GitHub).
# Создать: openssl rand -hex 32
VECHER_RELEASE_TOKEN=

# Приватные файлы в чате (каталог задаёт docker-compose.yml).
VECHER_ATTACHMENT_MAX_BYTES=26214400
VECHER_ATTACHMENT_PAIR_QUOTA_BYTES=262144000
VECHER_ATTACHMENT_PENDING_TTL_HOURS=24
# Планировщик чистит pending/orphan вложения и истёкшие звонки (по умолчанию включён).
VECHER_SCHEDULER_ENABLED=true

# Звонки: в staging выключены, пока не настроен собственный TURN.
# JSON-массивы, не строки через запятую. Готовые значения создаёт infra/turn/prepare.py.
VECHER_STUN_URLS=[]
VECHER_TURN_URLS=[]
VECHER_TURN_SECRET=
VECHER_TURN_CREDENTIAL_TTL_SECONDS=15000
VECHER_CALL_RING_TIMEOUT_SECONDS=60
VECHER_CALL_HEARTBEAT_TIMEOUT_SECONDS=90
VECHER_CALL_MAX_DURATION_SECONDS=14400
